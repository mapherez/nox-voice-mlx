# Copy this file to .env beside compose.yaml, then fill in the three REQUIRED values.
# See docs/getting-started.md. No installation-specific values are supplied here.

# REQUIRED: verified Google email allowed to sign in.
NOX_VOICE_OWNER_EMAIL=
# REQUIRED: Google OAuth Web application client ID (the secret goes in secrets/).
NOX_VOICE_GOOGLE_CLIENT_ID=
# REQUIRED: exact Gateway URL printed by setup on the Mac, including its port.
NOX_VOICE_CONTROLLER_URL=

# Local access stays enabled at this host port, including when a domain is configured.
NOX_VOICE_WEB_PORT=8080
# Optional HTTPS domain, available alongside localhost; leave empty for local-only use.
NOX_VOICE_PUBLIC_URL=
# Optional additional HTTPS origins, comma-separated (for example a LAN hostname).
NOX_VOICE_ALLOWED_ORIGINS=
NOX_VOICE_IMAGE_TAG=latest
# Create the files documented in docs/deployment.md under ./secrets/.
# Never commit .env, tokens, client keys, or server/CA keys.

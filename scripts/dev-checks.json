{
  "policy": "scripts/ci-policy.mjs",
  "go": false,
  "vite": ["frontend"],
  "check": [
    {
      "command": "uv",
      "args": ["run", "--frozen", "ruff", "check", "."],
      "cwd": "."
    },
    {
      "command": "npm",
      "args": ["run", "check"],
      "cwd": "frontend"
    }
  ],
  "python": true
}

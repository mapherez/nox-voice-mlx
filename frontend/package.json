{
  "name": "nox-voice-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "npm run check && vp build",
    "lint:html": "html-validate index.html",
    "test": "vp test run",
    "format": "vp fmt src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "vp fmt --check src index.html vite.config.ts tsconfig.json package.json",
    "preview": "vp preview --host 127.0.0.1",
    "check": "vp check --deny-warnings && npm run lint:html"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "html-validate": "11.17.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "npm@11.19.1"
}
